<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="member">

    <resultMap id="MemberResultMap" type="com.comdog.c2d.dto.MemberDto">
        <id property="id" column="member_id" />
        <result property="email" column="email" />
        <result property="password" column="password" />
        <result property="name" column="name" />
        <result property="phone" column="phone" />
        <result property="birthDate" column="birth_date" />
        <result property="genderDigit" column="gender_digit" />
        <result property="userType" column="user_type" />
        <result property="isSubscribed" column="is_subscribed" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <select id="findAllMembers" resultMap="MemberResultMap">
        SELECT * FROM member
    </select>

    <select id="findMemberById" resultMap="MemberResultMap">
        SELECT * FROM member
        WHERE member_id = #{id}
    </select>

    <insert id="insertMember" parameterType="com.comdog.c2d.dto.MemberDto">
        INSERT INTO member (
            email, password, name, phone,
            birth_date, gender_digit, user_type, is_subscribed
        ) VALUES (
            #{email}, #{password}, #{name}, #{phone},
            #{birthDate}, #{genderDigit}, #{userType}, #{isSubscribed}
        )
    </insert>

    <select id="login" parameterType="com.comdog.c2d.dto.MemberDto" resultType="com.comdog.c2d.dto.MemberDto">
        SELECT 
            member_id AS id, email, password, name, user_type AS userType
        FROM member
        WHERE email = #{email}
    </select>

    <select id="countByEmail" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM member
        WHERE email = #{email}
    </select>

    <update id="update" parameterType="com.comdog.c2d.dto.MemberDto">
        UPDATE member
        SET
            email = #{email},
            password = #{password},
            name = #{name},
            phone = #{phone},
            user_type = #{userType},
            is_subscribed = #{isSubscribed}
        WHERE member_id = #{id}
    </update>

    <delete id="deleteDeliveryByMemberId" parameterType="long">
        DELETE FROM delivery WHERE order_id IN (SELECT order_id FROM orders WHERE member_id = #{id})
    </delete>

    <delete id="deleteOrderItemByMemberId" parameterType="long">
        DELETE FROM order_item WHERE order_id IN (SELECT order_id FROM orders WHERE member_id = #{id})
    </delete>

    <delete id="deleteOrdersByMemberId" parameterType="long">
        DELETE FROM orders WHERE member_id = #{id}
    </delete>

    <delete id="delete" parameterType="long">
        DELETE FROM member WHERE member_id = #{id}
    </delete>

</mapper>